# ElevenLabs
ELEVENLABS_API_KEY=

# Google Cloud / Vertex AI (uses service account via ADC)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Local dev only: path to service account JSON key file
# On Cloud Run, ADC auto-discovers the attached service account -- leave blank.
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ElevenLabs Limits
ELEVENLABS_MAX_CONCURRENT=3
ELEVENLABS_MAX_CHARS_PER_REQUEST=2000

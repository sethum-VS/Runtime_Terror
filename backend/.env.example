# ElevenLabs
ELEVENLABS_API_KEY=

# Google Cloud / Vertex AI (uses service account via ADC)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Gemini 2.5 Pro (1M context) is used by the scene analyzer to extract
# the current topic/mood/environment per page for the live background.
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_PRO_MAX_OUTPUT_TOKENS=65536

# Veo 3.1 Lite live-background video generation (uses the google-genai
# SDK with vertexai=True, same ADC as Gemini). Set ENABLE_LIVE_BACKGROUNDS
# to "true" to turn the feature on.
VEO_MODEL=veo-3.1-lite-generate-001
VEO_ASPECT_RATIO=16:9
VEO_RESOLUTION=720p
VEO_DURATION_SECONDS=8
ENABLE_LIVE_BACKGROUNDS=false

# Local dev only: path to service account JSON key file
# On Cloud Run, ADC auto-discovers the attached service account -- leave blank.
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# App URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ElevenLabs Limits
ELEVENLABS_MAX_CONCURRENT=3
ELEVENLABS_MAX_CHARS_PER_REQUEST=2000

# Interactive narrator (ConvAI)
# English agents (language=en): use eleven_turbo_v2 or eleven_flash_v2 only
# Multilingual agents: eleven_turbo_v2_5 / eleven_flash_v2_5
ELEVENLABS_CONVAI_MODEL=gemini-2.0-flash
ELEVENLABS_CONVAI_TTS_MODEL=eleven_turbo_v2
